# Suerte / Aqbobek — главный сервер (8080). Пример .env.
# Реальный server/.env уже существует в проекте — допишите в него ТОЛЬКО
# две новые переменные снизу (X_INTERNAL_SECRET, AUTH_SERVER_INTERNAL_URL),
# остальные (ключи ИИ-провайдеров и т.д.) НЕ трогайте — они уже заполнены.

# ── LLM-провайдеры ──
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ── Токены доступа (X-Auth-Token) — как было ──
AQBOBEK_MAIN_TOKEN=
AQBOBEK_LOCAL_TOKEN=

# ── Локальный сервер ──
TESSERACT_CMD=

# ── Админ-панель (опционально) ──
# ADMIN_STORE=

# ══════════════════════ NEW: paywall-интеграция (ТЗ раздел 6) ══════════════════════
# Секрет между главным сервером (8080) и auth-сервером (1734).
# ЗНАЧЕНИЕ ДОЛЖНО СОВПАДАТЬ с X_INTERNAL_SECRET в auth_server/.env — это один
# и тот же секрет, общий для обоих серверов.
X_INTERNAL_SECRET=

# URL internal-эндпоинта auth-сервера. Если оба сервера на одной машине — не менять.
AUTH_SERVER_INTERNAL_URL=http://127.0.0.1:1734/internal/verify
