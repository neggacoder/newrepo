# ────────────────────────────────────────────────────────────────
# Suerte / Aqbobek — переменные окружения (секреты и токены)
# ────────────────────────────────────────────────────────────────
# Скопируйте этот файл в .env и заполните значения:
#     cp .env.example .env
# .env НЕ коммитится (см. .gitignore). Оба сервера грузят его автоматически
# (python-dotenv). Значения перекрывают одноимённые ключи в config.json.
#
# Приоритет: реальное окружение (systemd/shell) > .env > config.json > дефолты.

# ── ГЛАВНЫЙ сервер (server/) — LLM-провайдеры ──────────────────
# OpenAI (provider=openai; LLM + whisper-1). ВАЖНО: используйте НОВЫЙ ключ —
# прежний, лежавший в коде, скомпрометирован и должен быть отозван.
OPENAI_API_KEY=

# DeepSeek (provider=deepseek). https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ── Токены доступа (X-Auth-Token) ──────────────────────────────
# Главный сервер: если задан — /command,/ocr-template,/transcribe требуют токен.
# Тот же токен впишите в расширении: Настройки → Серверы → Токен доступа.
AQBOBEK_MAIN_TOKEN=

# ── Локальный сервер (user_server/) ────────────────────────────
# У локального сервера отдельного токена нет: защита — CORS (только
# расширение) + привязка к 127.0.0.1.
#
# Путь к tesseract.exe (Windows), если не в PATH.
TESSERACT_CMD=

# ── Админ-панель (опционально) ─────────────────────────────────
# Хранилище хешей пароля/PIN вне проекта (прод). Иначе — server/admin_secret.json.
# ADMIN_STORE=/etc/aqbobek/admin.json
