# Suerte / Vox — единый сервер. Пример .env.
# Скопируйте в vox_server/.env и заполните. .env НЕ коммитится (см. .gitignore).
#
# Приоритет: реальное окружение (systemd/shell) > .env > config.json > дефолты.
# Файлы читаются в порядке vox_server/.env, затем корневой .env; переменную,
# уже заданную в окружении или в более раннем файле, .env не перезаписывает
# (см. load_env_files в vox_server.py).

# ── LLM-провайдеры ──────────────────────────────────────────────
# OpenAI. Нужен и для provider=openai, и ВСЕГДА для распознавания речи
# (/transcribe уходит в OpenAI независимо от выбранного провайдера LLM).
OPENAI_API_KEY=

# DeepSeek (provider=deepseek). https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Ollama ключа не требует — он работает локально (см. ollama_url в config.json).

# ── OCR ─────────────────────────────────────────────────────────
# Путь к tesseract.exe (Windows), если он не в PATH.
TESSERACT_CMD=

# ── Служебное ───────────────────────────────────────────────────
# Куда класть хеши админ-панели (по умолчанию vox_server/admin_secret.json).
# ADMIN_STORE=

# Пути хранилищ; переопределяются в тестах, в бою менять не нужно.
# PATIENTS_DIR=
# TEMPLATES_DIR=
# OCR_TEMPLATES_DIR=
# USAGE_DB=
