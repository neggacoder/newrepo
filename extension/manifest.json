{
  "manifest_version": 3,
  "name": "Suerte AI Agent",
  "version": "11.0.0",
  "description": "AI-помощник для Damumed — голосовое управление и авто-заполнение документов",
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "action": {
    "default_icon": "icons/icon48.png",
    "default_title": "Suerte — помощник для Damumed"
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://hospital-akt.dmed.kz/*",
    "https://akt.dmed.kz/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "//": "Патч window.open в MAIN-мире. Только Damumed: проблема _blank его, а оборачивать window.open на каждом сайте врача незачем.",
      "matches": ["https://hospital-akt.dmed.kz/*","https://akt.dmed.kz/*"],
      "js": ["aq-same-tab.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>","https://hospital-akt.dmed.kz/*","https://akt.dmed.kz/*"],
      "js": ["medrecord-lines.js", "patient-ids.js", "aq-recorder.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["settings.html", "settings.js", "settings-theme.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
